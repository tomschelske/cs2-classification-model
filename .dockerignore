# Keep the build context small — exclude everything the image doesn't need.
.venv/
.git/
.github/
__pycache__/
**/__pycache__/
*.pyc
.DS_Store
notebooks/
docs/
models/*.png
models/*.joblib
data/demos/
data/*.parquet
data/parse_report.json
frontend/replay.template.html
frontend/build_replay.py
tests/
*.md
requirements.txt
requirements-test.txt
Dockerfile
.dockerignore
# NB: requirements-serve.txt is NOT ignored — the Dockerfile COPYs it.
